{
  "name": "dsh-latex-studio",
  "version": "0.4.1",
  "description": "MiKTeX-native LaTeX compile & VTO typesetting loop for DeepSeek Harness (daily compile + visual typesetting loop with a persistent defect ledger).",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "Qingzhu093",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qingzhu093/dsh-latex-studio.git"
  },
  "homepage": "https://github.com/Qingzhu093/dsh-latex-studio#readme",
  "bugs": {
    "url": "https://github.com/Qingzhu093/dsh-latex-studio/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "skills",
    "locale",
    "icon.svg",
    "test",
    "tools/verify-pdf-read.mjs",
    "tools/vendor-paperfit-specs.mjs",
    "tools/build-preview.mjs",
    "tools/verify-package.mjs",
    "tools/doctor.mjs",
    "tools/install.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "latex",
    "miktex",
    "typesetting"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "scripts": {
    "test": "node test/run-all.mjs",
    "doctor": "node tools/doctor.mjs",
    "install-plugin": "node tools/install.mjs",
    "preview": "node tools/build-preview.mjs",
    "verify:package": "node tools/verify-package.mjs",
    "vendor-specs": "node tools/vendor-paperfit-specs.mjs"
  }
}
